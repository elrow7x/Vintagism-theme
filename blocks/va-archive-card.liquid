{% doc %}
  Scheda d'archivio · direzione Index: tabella con N° inventario, brand, decennio, taglia, materiale,
  misure, condizione, difetti. Dati da metafield custom.* o, in alternativa, dai tag "chiave:valore".
{% enddoc %}
{%- liquid
  assign p = closest.product
  if p == blank
    assign p = product
  endif
-%}
{%- if p != blank -%}
  {%- capture f_inv -%}{%- render 'va-archive-field', product: p, key: 'inv' -%}{%- endcapture -%}
  {%- capture f_dec -%}{%- render 'va-archive-field', product: p, key: 'decennio' -%}{%- endcapture -%}
  {%- capture f_size -%}{%- render 'va-archive-field', product: p, key: 'taglia' -%}{%- endcapture -%}
  {%- capture f_meas -%}{%- render 'va-archive-field', product: p, key: 'misure' -%}{%- endcapture -%}
  {%- capture f_cond -%}{%- render 'va-archive-field', product: p, key: 'condizione' -%}{%- endcapture -%}
  {%- capture f_def -%}{%- render 'va-archive-field', product: p, key: 'difetti' -%}{%- endcapture -%}
  {%- capture f_mat -%}{%- render 'va-archive-field', product: p, key: 'materiale' -%}{%- endcapture -%}

  <div class="va-sheet" {{ block.shopify_attributes }}>
    {%- if f_inv != blank -%}<p class="va-meta">{{ f_inv }}</p>{%- endif -%}
    <table class="va-table">
      {%- if p.vendor != blank -%}<tr><td>Brand</td><td><a href="{{ p.vendor | url_for_vendor }}">{{ p.vendor }}</a></td></tr>{%- endif -%}
      {%- if f_dec != blank -%}<tr><td>Decennio</td><td>{{ f_dec }}</td></tr>{%- endif -%}
      {%- if f_size != blank -%}<tr><td>Taglia</td><td>{{ f_size }}</td></tr>{%- endif -%}
      {%- if f_mat != blank -%}<tr><td>Materiale</td><td>{{ f_mat }}</td></tr>{%- endif -%}
      {%- if f_meas != blank -%}<tr><td>Misure cm</td><td>{{ f_meas }}</td></tr>{%- endif -%}
      {%- if f_cond != blank -%}<tr><td>Condizione</td><td>{{ f_cond }}</td></tr>{%- endif -%}
      {%- if f_def != blank -%}<tr><td>Difetti</td><td>{{ f_def }}</td></tr>{%- endif -%}
    </table>
    {%- if block.settings.note != blank -%}<p class="va-sheet__note">{{ block.settings.note }}</p>{%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Scheda d'archivio",
  "tag": null,
  "settings": [
    { "type": "text", "id": "note", "label": "Nota sotto la scheda", "default": "Pezzo unico. Misure prese a capo disteso." }
  ],
  "presets": [{ "name": "Scheda d'archivio" }]
}
{% endschema %}
