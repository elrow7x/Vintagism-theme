{%- liquid
  assign vendors = shop.vendors | sort_natural
  assign letters = ''
  for v in vendors
    assign l = v | slice: 0 | upcase
    unless letters contains l
      assign letters = letters | append: l
    endunless
  endfor
  assign letters_arr = letters | split: ''
-%}
<section class="va-pad va-block va-brands">
  <div class="va-row va-row--head">
    <span>{{ section.settings.title }}</span>
    <span class="va-grey">{{ vendors.size | prepend: '000' | slice: -3, 3 }}</span>
  </div>
  {%- if vendors.size > 0 -%}
    <nav class="va-brands__letters" aria-label="Lettere">
      {%- for l in letters_arr -%}<a href="#va-brand-{{ l }}">{{ l }}</a>{%- endfor -%}
    </nav>
    <div class="va-brands__cols">
      {%- for l in letters_arr -%}
        <div class="va-brands__group" id="va-brand-{{ l }}">
          <p class="va-brands__letter">{{ l }}</p>
          <ul>
            {%- for v in vendors -%}
              {%- assign first = v | slice: 0 | upcase -%}
              {%- if first == l -%}
                {%- liquid
                  assign c = 0
                  for p in collections.all.products
                    if p.vendor == v
                      assign c = c | plus: 1
                    endif
                  endfor
                -%}
                <li><a href="{{ v | url_for_vendor }}"><span>{{ v }}</span><span class="va-grey">{{ c | prepend: '00' | slice: -3, 3 }}</span></a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>
  {%- else -%}
    <p class="va-empty">[Da completare] I brand compaiono qui in automatico appena carichi i capi.</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "VA · Brand A–Z",
  "tag": null,
  "settings": [
    { "type": "text", "id": "title", "label": "Titolo riga", "default": "Brand A–Z" }
  ],
  "presets": [{ "name": "VA · Brand A–Z" }]
}
{% endschema %}
