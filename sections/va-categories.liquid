<section class="va-section va-cats" data-va-section>
  <header class="va-section__head">
    <div>
      <p class="va-label">{{ section.settings.kicker }}</p>
      <h2 class="va-h2">{{ section.settings.title_1 }} <em>{{ section.settings.title_accent }}</em></h2>
    </div>
  </header>
  <div class="va-cats__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign img = block.settings.image
        assign count = 0
        assign match = block.settings.match_type | downcase | strip
        assign match_tag = block.settings.match_tag | downcase | strip
        for product in collections.all.products
          assign ok = true
          if match != blank
            assign ptype = product.type | downcase
            if ptype != match
              assign ok = false
            endif
          endif
          if match_tag != blank
            assign tags_down = product.tags | join: '|' | downcase | split: '|'
            unless tags_down contains match_tag
              assign ok = false
            endunless
          endif
          if ok
            assign count = count | plus: 1
            if img == blank
              assign img = product.featured_media
            endif
          endif
        endfor
      -%}
      <a class="va-cat va-reveal" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
        <div class="va-cat__media va-brackets va-brackets--hover">
          {%- if img -%}
            {{ img | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', widths: '360, 540, 700', alt: '' }}
          {%- endif -%}
        </div>
        <div class="va-cat__label">
          <span>{{ block.settings.label }}</span>
          <span class="va-mono">{{ count | prepend: '000' | slice: -3, 3 }}</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "VA · Categorie",
  "tag": null,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Etichetta", "default": "Indice" },
    { "type": "text", "id": "title_1", "label": "Titolo", "default": "Sfoglia per" },
    { "type": "text", "id": "title_accent", "label": "Titolo (corsivo)", "default": "categoria" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoria",
      "settings": [
        { "type": "text", "id": "label", "label": "Etichetta", "default": "Categoria" },
        { "type": "text", "id": "url", "label": "Link", "default": "/collections/all" },
        { "type": "text", "id": "match_type", "label": "Tipo prodotto (per foto e conteggio)" },
        { "type": "text", "id": "match_tag", "label": "Tag (per foto e conteggio)" },
        { "type": "image_picker", "id": "image", "label": "Immagine (vuoto = automatica)" }
      ]
    }
  ],
  "presets": [{ "name": "VA · Categorie" }]
}
{% endschema %}
