{%- comment -%}
  Barra indice sotto l'header: le "linguette" dell'archivio.
  I link puntano a pagine native di Shopify (tag, tipo prodotto, vista brand), quindi funzionano senza creare collezioni.
{%- endcomment -%}
<nav class="va-catbar" aria-label="Categorie">
  <div class="va-catbar__inner">
    {%- for block in section.blocks -%}
      {%- liquid
        assign url = block.settings.url
        assign is_current = false
        if url != blank and request.path != '/' and url contains request.path
          assign is_current = true
        endif
      -%}
      <a
        class="va-catbar__link{% if block.settings.accent %} va-catbar__link--accent{% endif %}"
        href="{{ url }}"
        {% if is_current %}aria-current="page"{% endif %}
        {{ block.shopify_attributes }}
      >{{ block.settings.label }}</a>
    {%- endfor -%}
  </div>
</nav>

{% schema %}
{
  "name": "VA · Barra categorie",
  "tag": "div",
  "class": "va-catbar-section",
  "enabled_on": { "groups": ["header"] },
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Etichetta", "default": "Categoria" },
        { "type": "text", "id": "url", "label": "Link (es. /collections/types?q=Borse)", "default": "/collections/all" },
        { "type": "checkbox", "id": "accent", "label": "Evidenzia", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "VA · Barra categorie" }]
}
{% endschema %}
