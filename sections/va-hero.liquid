{%- liquid
  assign img = section.settings.image
  if img == blank
    for p in collections.all.products
      if p.available and p.featured_media
        assign img = p.featured_media
        break
      endif
    endfor
  endif
-%}
<section class="va-hero va-pad">
  <div class="va-hero__media va-br">
    {%- if img -%}
      {{ img | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 40vw, 100vw', widths: '600, 900, 1200, 1600', alt: '' }}
    {%- endif -%}
  </div>
  <div class="va-hero__copy">
    <div>
      <p class="va-meta">{{ section.settings.kicker }}</p>
      <h1 class="va-hero__title">{{ section.settings.title }}</h1>
    </div>
    <div>
      <p class="va-hero__text">{{ section.settings.text }}</p>
      <a class="va-row" href="{{ section.settings.cta_1_url | default: '/collections/all' }}"><span>{{ section.settings.cta_1 }}</span><span>→</span></a>
      <a class="va-row va-row--last" href="{{ section.settings.cta_2_url | default: '/collections/all?view=brands' }}"><span>{{ section.settings.cta_2 }}</span><span>→</span></a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VA · Apertura",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Immagine (vuoto = primo capo disponibile)" },
    { "type": "text", "id": "kicker", "label": "Riga sopra il titolo", "default": "Stagione 01 — Inverno 2026" },
    { "type": "text", "id": "title", "label": "Titolo", "default": "Ogni pezzo esiste una volta sola." },
    { "type": "textarea", "id": "text", "label": "Testo", "default": "Trent'anni di vintage selezionato a Napoli. Ora una parte dell'archivio si compra al pezzo: catalogata, misurata, fotografata così com'è." },
    { "type": "text", "id": "cta_1", "label": "Link 1", "default": "Entra nell'archivio" },
    { "type": "url", "id": "cta_1_url", "label": "URL link 1" },
    { "type": "text", "id": "cta_2", "label": "Link 2", "default": "Brand A–Z" },
    { "type": "url", "id": "cta_2_url", "label": "URL link 2" }
  ],
  "presets": [{ "name": "VA · Apertura" }]
}
{% endschema %}
