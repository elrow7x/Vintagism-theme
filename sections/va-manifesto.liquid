<div class="va-pad va-block va-manifesto">
  <div class="va-row va-row--head"><span>{{ section.settings.kicker }}</span><span class="va-grey">{{ section.blocks.size | prepend: '00' | slice: -3, 3 }}</span></div>
  <ol class="va-manifesto__list">
    {%- for block in section.blocks -%}
      <li class="va-manifesto__item{% if block.settings.accent %} is-accent{% endif %}" {{ block.shopify_attributes }}>
        <span class="va-manifesto__n">{{ forloop.index | prepend: '0' }}</span>
        <span class="va-manifesto__line">{{ block.settings.line }}</span>
      </li>
    {%- endfor -%}
  </ol>
</div>

{% schema %}
{
  "name": "VA · Manifesto",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Titolo riga", "default": "Regole dell'archivio" }
  ],
  "blocks": [
    {
      "type": "line",
      "name": "Regola",
      "settings": [
        { "type": "text", "id": "line", "label": "Testo", "default": "Non ristampiamo." },
        { "type": "checkbox", "id": "accent", "label": "Segna con squadretta oro", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "VA · Manifesto" }]
}
{% endschema %}
