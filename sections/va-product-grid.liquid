{%- liquid
  assign src = section.settings.collection
  if src == blank
    assign src = collections.all
  endif
  assign limit = section.settings.limit
  assign filter_tag = section.settings.filter_tag | downcase | strip
  assign shown = 0
-%}
<section class="va-pad va-block">
  <a class="va-row va-row--head" href="{{ section.settings.link_url | default: '/collections/all' }}">
    <span>{{ section.settings.title }}</span>
    <span class="va-grey">{{ section.settings.link_label }} →</span>
  </a>
  <div class="va-grid">
    {%- for product in src.products -%}
      {%- liquid
        if shown >= limit
          break
        endif
        if filter_tag != blank
          assign tags_down = product.tags | join: '|' | downcase | split: '|'
          unless tags_down contains filter_tag
            continue
          endunless
        endif
        assign shown = shown | plus: 1
      -%}
      {% render 'va-card', product: product, sizes: '(min-width: 990px) 20vw, 50vw' %}
    {%- else -%}
      <p class="va-empty">[Da completare] Importa i prodotti demo per vedere la griglia.</p>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "VA · Griglia capi",
  "tag": null,
  "settings": [
    { "type": "text", "id": "title", "label": "Titolo riga", "default": "Nuovi in archivio" },
    { "type": "collection", "id": "collection", "label": "Collezione (vuoto = tutti i capi)" },
    { "type": "text", "id": "filter_tag", "label": "Filtra per tag (es. rare)" },
    { "type": "range", "id": "limit", "label": "Numero capi", "min": 4, "max": 24, "step": 4, "default": 8 },
    { "type": "text", "id": "link_label", "label": "Testo link", "default": "Vedi tutto" },
    { "type": "text", "id": "link_url", "label": "Link", "default": "/collections/all" }
  ],
  "presets": [{ "name": "VA · Griglia capi" }]
}
{% endschema %}
