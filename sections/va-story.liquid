<section class="va-pad va-block va-story">
  <div class="va-row va-row--head"><span>{{ section.settings.title }}</span><span class="va-grey">{{ section.settings.year }}</span></div>
  <div class="va-story__grid">
    <div class="va-story__text">{{ section.settings.text }}</div>
    <table class="va-table">
      {%- for block in section.blocks -%}
        <tr {{ block.shopify_attributes }}><td>{{ forloop.index | prepend: '0' }} — {{ block.settings.title }}</td><td>{{ block.settings.text }}</td></tr>
      {%- endfor -%}
    </table>
  </div>
</section>

{% schema %}
{
  "name": "VA · Storia",
  "tag": null,
  "settings": [
    { "type": "text", "id": "title", "label": "Titolo riga", "default": "Chi siamo" },
    { "type": "text", "id": "year", "label": "Anno", "default": "Est. 1995" },
    { "type": "richtext", "id": "text", "label": "Testo", "default": "<p>Vintagism nasce nel 1995 tra i banchi del mercato di Resina. Da allora selezioniamo vintage per boutique e rivenditori in tutta Europa. Vintagism Archive è la selezione al pezzo: i capi migliori che passano dal magazzino.</p>" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Riga",
      "settings": [
        { "type": "text", "id": "title", "label": "Voce", "default": "Selezione" },
        { "type": "text", "id": "text", "label": "Testo", "default": "Ogni capo è scelto a mano." }
      ]
    }
  ],
  "presets": [{ "name": "VA · Storia" }]
}
{% endschema %}
