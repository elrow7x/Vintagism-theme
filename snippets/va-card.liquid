{% doc %}
  Card capo Vintagism Archive: foto 4:5 con squadrette, badge, brand, titolo, taglia, prezzo.

  @param {product} product
  @param {string} [sizes] - attributo sizes per l'immagine
{% enddoc %}
{%- liquid
  capture f_size
    render 'va-archive-field', product: product, key: 'taglia'
  endcapture
  capture f_inv
    render 'va-archive-field', product: product, key: 'inv'
  endcapture
  assign tags_down = product.tags | join: '|' | downcase | split: '|'
  assign img = product.featured_media
  assign img2 = product.media[1]
  assign title_clean = product.title
  if product.vendor != blank
    assign title_clean = title_clean | remove: product.vendor
  endif
  assign title_parts = title_clean | split: ' · '
  assign title_short = title_parts | last
-%}
<article class="va-card{% unless product.available %} is-sold{% endunless %}">
  <a class="va-card__link" href="{{ product.url }}">
    <div class="va-card__media va-brackets va-brackets--hover">
      {%- if img -%}
        {{ img | image_url: width: 900 | image_tag: loading: 'lazy', class: 'va-card__img', sizes: sizes, widths: '360, 540, 720, 900', alt: product.title }}
        {%- if img2 -%}
          {{ img2 | image_url: width: 900 | image_tag: loading: 'lazy', class: 'va-card__img va-card__img--alt', sizes: sizes, widths: '360, 540, 720, 900', alt: '' }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'va-card__img' }}
      {%- endif -%}
      <div class="va-badges">
        {%- unless product.available -%}<span class="va-badge va-badge--sold">Sold</span>{%- endunless -%}
        {%- if tags_down contains 'rare' -%}<span class="va-badge va-badge--rare">Rare</span>{%- endif -%}
        {%- if product.available and tags_down contains 'new' -%}<span class="va-badge">New</span>{%- endif -%}
      </div>
    </div>
    <div class="va-card__info">
      <p class="va-card__brand">{{ product.vendor }}</p>
      <h3 class="va-card__title">{{ title_short | strip }}</h3>
      <p class="va-card__meta">
        {%- if f_size != blank -%}<span>Tg. {{ f_size }}</span>{%- endif -%}
        <span class="va-card__price">{{ product.price | money }}</span>
      </p>
    </div>
  </a>
</article>
