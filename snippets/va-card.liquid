{% doc %}
  Card capo · direzione Index: foto 4:5 con squadrette, etichetta Sold/Rare, due righe di dati.

  @param {product} product
  @param {string} [sizes] - attributo sizes per l'immagine
{% enddoc %}
{%- liquid
  capture f_size
    render 'va-archive-field', product: product, key: 'taglia'
  endcapture
  assign tags_down = product.tags | join: '|' | downcase | split: '|'
  assign img = product.featured_media
  assign img2 = product.media[1]
  assign title_parts = product.title | split: ' · '
  assign title_short = title_parts | last | strip
-%}
<article class="va-card{% unless product.available %} is-sold{% endunless %}">
  <a class="va-card__link" href="{{ product.url }}">
    <div class="va-card__media va-br">
      {%- if img -%}
        {{ img | image_url: width: 900 | image_tag: loading: 'lazy', class: 'va-card__img', sizes: sizes, widths: '360, 540, 720, 900', alt: product.title }}
        {%- if img2 -%}
          {{ img2 | image_url: width: 900 | image_tag: loading: 'lazy', class: 'va-card__img va-card__img--alt', sizes: sizes, widths: '360, 540, 720, 900', alt: '' }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'va-card__img' }}
      {%- endif -%}
      {%- unless product.available -%}
        <span class="va-tag">Sold</span>
      {%- else -%}
        {%- if tags_down contains 'rare' -%}<span class="va-tag va-tag--k">Rare</span>{%- elsif tags_down contains 'new' -%}<span class="va-tag">New</span>{%- endif -%}
      {%- endunless -%}
    </div>
    <div class="va-card__meta">
      <span class="va-card__brand">{{ product.vendor }}</span>
      <span class="va-card__price">{{ product.price | money_without_trailing_zeros }}</span>
      <span class="va-card__name">{{ title_short }}</span>
      <span class="va-card__size">{{ f_size }}</span>
    </div>
  </a>
</article>
